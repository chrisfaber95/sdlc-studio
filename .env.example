# Bind address. Default is loopback. Use the Tailscale address (tailscale ip -4) to serve the tailnet directly.
# 0.0.0.0 and :: are refused unless SDLC_ALLOW_WILDCARD_BIND=1.
SDLC_HOST=127.0.0.1
SDLC_PORT=8110

# Homelab LLM router (H-012). The app has no Claude API key; the router holds the Claude CLI subscription.
SDLC_ROUTER_URL=http://127.0.0.1:8018
SDLC_ROUTER_TOKEN=

# Who is the owner: Tailscale logins (comma separated) and/or a shared token for the CLI skill and scripts.
SDLC_OWNER_IDENTITIES=
SDLC_OWNER_TOKEN=

SDLC_DB_PATH=./data/sdlc-studio.db

# Used by the /new-project skill client (backend/src/client), not by the server:
# SDLC_URL=http://127.0.0.1:8110
# (it reuses SDLC_OWNER_TOKEN above)
