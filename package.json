{
  "name": "sdlc-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "build": "npm run build --workspaces",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "e2e": "playwright test -c e2e/playwright.config.ts --project=chromium",
    "screenshots": "playwright test -c e2e/playwright.config.ts --project=screenshots"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.1"
  }
}
